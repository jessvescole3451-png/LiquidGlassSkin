<?xml version="1.0" encoding="utf-8"?>
<!--
  LIQUID GLASS — Colores
  ─────────────────────────────────────────────────────────────────
  IMPORTANTE: Esta skin NO define colores de fondo fijos.
  Los colores vienen de:
    1. Material You  → sistema Android 12+ (fondo de pantalla)
    2. Album Art (AAA) → Poweramp extrae colores de la portada
    3. El usuario puede elegir en Ajustes de Poweramp
  ─────────────────────────────────────────────────────────────────
-->
<resources>

    <!-- ══════════════════════════════════════════════════════
         VIDRIO (GLASS) — Siempre semitransparente blanco
         Estos SÍ son fijos: son la capa de cristal encima
         del color dinámico que venga de Material You / álbum
         ══════════════════════════════════════════════════════ -->

    <!-- Panel principal de cristal: blanco al 20% -->
    <color name="glass_panel">#33FFFFFF</color>
    <!-- Cristal más claro para elementos superiores -->
    <color name="glass_panel_light">#4DFFFFFF</color>
    <!-- Botones de cristal -->
    <color name="glass_button">#60FFFFFF</color>
    <!-- Botón presionado -->
    <color name="glass_button_pressed">#80FFFFFF</color>
    <!-- Borde/Rim de cristal -->
    <color name="glass_border">#70FFFFFF</color>
    <!-- Overlay muy sutil -->
    <color name="glass_overlay">#1AFFFFFF</color>
    <!-- Ripple touch feedback -->
    <color name="ripple_glass">#40FFFFFF</color>

    <!-- ══════════════════════════════════════════════════════
         TEXTO — Siempre blanco (funciona sobre cualquier color)
         ══════════════════════════════════════════════════════ -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#CCFFFFFF</color>
    <color name="text_hint">#80FFFFFF</color>

    <!-- ══════════════════════════════════════════════════════
         BARRA DE PROGRESO
         ══════════════════════════════════════════════════════ -->
    <color name="progress_fill">#FFFFFFFF</color>
    <color name="progress_bg">#40FFFFFF</color>

    <!-- ══════════════════════════════════════════════════════
         FONDO FALLBACK — Solo para Android < 12 sin Material You
         Neutro/oscuro para que el cristal se vea bien con cualquier
         color de álbum que Poweramp extraiga
         ══════════════════════════════════════════════════════ -->
    <color name="bg_fallback_dark">#1A1A1A</color>
    <color name="bg_fallback_scrim">#80000000</color>

</resources>
