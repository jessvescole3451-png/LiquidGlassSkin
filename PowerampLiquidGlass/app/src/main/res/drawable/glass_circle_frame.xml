<?xml version="1.0" encoding="utf-8"?>
<!-- Glass circle frame for album art -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#20B0A0E0"/>
            <stroke android:width="3dp" android:color="#40D4C5FF"/>
        </shape>
    </item>
    <!-- Inner rim -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#80FFFFFF"/>
        </shape>
    </item>
</layer-list>
