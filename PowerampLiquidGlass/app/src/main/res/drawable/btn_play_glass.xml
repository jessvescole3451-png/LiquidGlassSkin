<?xml version="1.0" encoding="utf-8"?>
<!-- Play button: large frosted glass circle with glow -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <!-- Outer glow ring -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <solid android:color="#20FFFFFF"/>
                    <stroke android:width="2dp" android:color="#80FFFFFF"/>
                </shape>
            </item>
            <!-- Inner glass fill -->
            <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="oval">
                    <solid android:color="#60FFFFFF"/>
                    <stroke android:width="1dp" android:color="#B0FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
