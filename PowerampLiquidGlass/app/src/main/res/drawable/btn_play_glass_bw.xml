<?xml version="1.0" encoding="utf-8"?>
<!-- Play button B&W: círculo de cristal blanco brillante sobre negro -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#50FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <!-- Resplandor exterior -->
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="oval">
                    <solid android:color="#10FFFFFF"/>
                    <stroke android:width="3dp" android:color="#60FFFFFF"/>
                </shape>
            </item>
            <!-- Cristal interior -->
            <item android:top="7dp" android:left="7dp" android:right="7dp" android:bottom="7dp">
                <shape android:shape="oval">
                    <solid android:color="#50FFFFFF"/>
                    <stroke android:width="1.5dp" android:color="#CCFFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
