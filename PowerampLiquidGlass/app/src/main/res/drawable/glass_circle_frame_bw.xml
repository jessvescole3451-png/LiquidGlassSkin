<?xml version="1.0" encoding="utf-8"?>
<!-- Marco circular B&W: anillo blanco brillante sobre negro -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Resplandor exterior difuso -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#15FFFFFF"/>
            <stroke android:width="4dp" android:color="#30FFFFFF"/>
        </shape>
    </item>
    <!-- Anillo blanco brillante (rim light) -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="2dp" android:color="#B0FFFFFF"/>
        </shape>
    </item>
    <!-- Anillo interior sutil -->
    <item android:top="10dp" android:left="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#40FFFFFF"/>
        </shape>
    </item>
</layer-list>
